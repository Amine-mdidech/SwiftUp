rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // This app's XP economy (spending, ad-unlock cooldowns, skill-level promotion) is entirely
    // client-computed and only gated by "is this uid's own document" — a user could in principle
    // write any value into their own xpBalance/skillLevel/etc. Accepted: nothing here is visible
    // to or affects any other user, and there's no server component to enforce it against.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /dailyCompletions/{date} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /bookmarks/{questionId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /flashcardReviews/{questionId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
    match /questions/{questionId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /dailyQuizzes/{date} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /interviewBank/{categorySlug} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /pathTracks/{trackId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /pathStageContent/{stageId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /pathRegradeQuizzes/{grade} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // The leaderboard feature has been removed from the app; nothing reads or writes this
    // collection anymore. Deny access explicitly rather than deleting the rule block outright — a
    // stray `leaderboardEntries` collection from before this change may still exist in production
    // Firestore, and an explicit deny documents that it's retired rather than merely unhandled.
    match /leaderboardEntries/{uid} {
      allow read, write: if false;
    }
  }
}
